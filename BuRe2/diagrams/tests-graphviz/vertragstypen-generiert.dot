// Setze dieses Diagramm in Graphviz um. Die Farben sind egal, aber die Boxern sollen genau so angeordnet sein: linke Hälfte Vertragstypen von oben nach unten, rechte Hälfte Unterkategorien der Vertragstypen.

// BuRe2/diagrams/vertragstypen-styled.dot
digraph G {
  rankdir=LR;
  splines=ortho;
  node [shape=box];

  // Root
  root [label="Vertragstypen"];

  // ===== BLOCK 1 =====
  subgraph cluster_v1 {
    label="";
    color=white;

    v1 [label="Veräusserungsverträge"];

    k [label="Kaufvertrag (Art. 184 ff. OR)"];
    t [label="Tausch (Art. 237 f. OR)"];
    s [label="Schenkung (Art. 239 ff. OR)"];

    v1 -> k;
    k -> t;
    t -> s;

    { rank=same; v1; k }
  }

  // ===== BLOCK 2 =====
  subgraph cluster_v2 {
    label="";
    color=white;

    v2 [label="Gebrauchsüberlassungsverträge"];

    m [label="Miete (Art. 253 ff. OR)"];
    p [label="Pacht (Art. 275 ff. OR)"];
    g [label="Gebrauchsleihe (Art. 305 ff. OR)"];
    d [label="Darlehen (Art. 312 ff. OR)"];
    l [label="Leasing (KKG)"];

    v2 -> m;
    m -> p;
    p -> g;
    g -> d;
    d -> l;

    { rank=same; v2; m }
  }

  // ===== BLOCK 3 =====
  subgraph cluster_v3 {
    label="";
    color=white;

    v3 [label="Verträge auf Arbeitsleistung"];

    a [label="Arbeitsvertrag (Art. 319 ff. OR)"];
    w [label="Werkvertrag (Art. 363 ff. OR)"];
    au [label="Auftrag (Art. 394 ff. OR)"];

    v3 -> a;
    a -> w;
    w -> au;

    { rank=same; v3; a }
  }

  // ===== BLOCK 4 =====
  subgraph cluster_v4 {
    label="";
    color=white;

    v4 [label="Weitere Verträge"];
    inn [label="Innominatverträge"];

    v4 -> inn;

    { rank=same; v4; inn }
  }

  // Root verbindet zu allen linken Boxen
  root -> v1;
  root -> v2;
  root -> v3;
  root -> v4;

  // 🔑 Vertikale Reihenfolge erzwingen
  root -> v1 [style=invis];
  v1 -> v2 [style=invis];
  v2 -> v3 [style=invis];
  v3 -> v4 [style=invis];
}