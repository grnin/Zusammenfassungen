                <mxCell id="39" value="&lt;ul style=&quot;padding-left: 15px; margin: 5px 0px 2px; padding-bottom: 0px; padding-right: 0px; line-height: 130%;&quot;&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Prostitutionsvertrag (umstritten)&lt;/span&gt;&lt;/li&gt;&lt;li&gt;bezahlte Unterstützung der Erbschleicherei&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontSize=13;spacingLeft=0;spacing=2;" parent="1" vertex="1">
                    <mxGeometry x="410" y="240" width="320" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="43" value="&lt;span style=&quot;background-color: transparent; line-height: 130%;&quot;&gt;&lt;b&gt;Beispiel ausnutzen von Notlage:&lt;br&gt;&lt;/b&gt;&lt;font style=&quot;font-size: 12px; line-height: 130%;&quot;&gt;Thomas, äusserst verzweifelt ob des akuten und prekären Gesundheitszustandes seiner Frau, kommt zum weit und breit einzigen Apotheker Stefan, um lebensnotwendige Medikamente zu kaufen. &lt;br&gt;Stefan wittert die Gunst der Stunde und verlangt für die fiebersenkenden Medikamente CHF 320.00 statt CHF 32.00.&lt;/font&gt;&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;spacingLeft=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="410" y="490" width="670" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="46" value="&lt;span&gt;&lt;font style=&quot;color: rgb(0, 0, 153);&quot;&gt;möglich wenn keine Gewährleistungsansprüche mehr&lt;/font&gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#0000CC;" parent="1" vertex="1">
                    <mxGeometry x="100" y="567" width="360" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="50" value="&lt;ul style=&quot;padding-left: 15px; margin: 13px 0px; padding-bottom: 0px; padding-right: 0px; line-height: 130%;&quot;&gt;&lt;li style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;p style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); margin: 0px; padding: 0px; color: rgb(63, 63, 63);&quot; data-path-to-node=&quot;15,1,1,1,0&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Paul Popp bestellt irrtümlich 500 Flaschen Wein statt wie beabsichtigt nur 50.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;p style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); margin: 0px; padding: 0px; color: rgb(63, 63, 63);&quot; data-path-to-node=&quot;15,1,1,1,0&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;Hans Heule kauft ein «unfallfreies» Auto, das sich später als Unfallauto erweist (ohne dass der Verkäufer dies gewusst hätte).&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;spacingLeft=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;spacing=7;" parent="1" vertex="1">
                    <mxGeometry x="470" y="585" width="610" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="51" value="&lt;ul style=&quot;padding-left: 15px; margin: 13px 0px; padding-bottom: 0px; padding-right: 0px;&quot;&gt;&lt;li style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;p style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); margin: 0px; padding: 0px; color: rgb(63, 63, 63);&quot; data-path-to-node=&quot;15,1,1,1,0&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); line-height: 130%;&quot;&gt;Der Garagist Georg Gründler verkauft einen Gebrauchtwagen wider besseres Wissen als «unfallfrei».&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;spacingLeft=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;" parent="1" vertex="1">
                    <mxGeometry x="470" y="663" width="610" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="52" value="&lt;ul style=&quot;padding-left: 15px; margin: 13px 0px; padding-bottom: 0px; padding-right: 0px;&quot;&gt;&lt;li style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;p style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); margin: 0px; padding: 0px; color: rgb(63, 63, 63);&quot; data-path-to-node=&quot;15,1,1,1,0&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); line-height: 130%;&quot;&gt;Der Nachbar droht Hans Huber, ihn wegen eines Bagatelldelikts anzuzeigen, wenn er ihm nicht seinen Porsche über das Wochenende ausleiht. Hans Huber willigt zähneknirschend ein.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;spacingLeft=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=none;" parent="1" vertex="1">
