                <mxCell id="38" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: rgb(251, 251, 251); float: none; color: rgb(0, 0, 0); display: inline !important;&quot;&gt;&lt;font style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;Sofern Mangel nur Teile des&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;Vertrags&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); background-color: light-dark(rgb(251, 251, 251), rgb(21, 21, 21));&quot;&gt;betrifft, gegebenenfalls&lt;/span&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;br style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); text-wrap-mode: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;strokeColor=none;strokeWidth=1;spacingLeft=10;spacingRight=5;spacingTop=8;spacingBottom=8;fontFamily=Helvetica;fontSize=13;fontColor=#000000;fillColor=none;" parent="1" vertex="1">
